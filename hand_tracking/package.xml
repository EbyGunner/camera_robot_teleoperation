<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hand_tracking</name>
  <version>0.1.0</version>
  <description>Webcam hand tracking publishing HandState messages for teleoperation.</description>
  <maintainer email="ebyj23@gmail.com">gunner</maintainer>
  <license>Apache-2.0</license>

  <!-- PATCH: this is a pure ament_python package. The old file declared an
       ament_cmake buildtool dependency (and the repo shipped a dead
       CMakeLists.txt) even though the build_type export was ament_python.
       Delete hand_tracking/CMakeLists.txt when applying this patch. -->

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- mediapipe is not rosdep-resolvable: install via pip (see README /
       mediapipe_loader.py for supported locations). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
